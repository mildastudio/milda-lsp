{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["esnext"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "tools/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
