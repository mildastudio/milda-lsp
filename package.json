{
  "name": "@mildastudio/milda-lsp",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "description": "Language Server (LSP) for the Milda design-system DSL - diagnostics, completion, hover, go-to-definition, outline, folding and semantic highlighting for any LSP-capable editor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mildastudio/milda-lsp.git"
  },
  "bin": {
    "milda-lsp": "./dist/index.cjs"
  },
  "exports": {
    ".": {
      "default": "./dist/index.cjs"
    },
    "./highlight": {
      "default": "./dist/highlight.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:highlight": "tsx tools/gen-highlight.ts"
  },
  "dependencies": {
    "@mildastudio/milda": "^0.3.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
